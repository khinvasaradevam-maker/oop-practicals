#include <iostream>
#include <string>
using namespace std;

class Staff {
private:
    int id;
    string pst;

public:
    void get() {
        cin >> id;
        cin.ignore();
        getline(cin, pst);
    }

    void show() {
        cout << id << " " << pst << endl;
    }
};

int main() {
    Staff s[2];

    for(int i = 0; i < 2; i++) {
        s[i].get();
    }

    for(int i = 0; i < 2; i++) {
        s[i].show();
    }

    return 0;
}
