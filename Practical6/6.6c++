#include <iostream>
using namespace std;

class Number
{
    int value;

public:
    void getData()
    {
        cout << "Enter value: ";
        cin >> value;
    }

    friend void compare(Number n1, Number n2);
};

void compare(Number n1, Number n2)
{
    if (n1.value > n2.value)
        cout << "First object is greater";
    else if (n2.value > n1.value)
        cout << "Second object is greater";
    else
        cout << "Both objects are equal";
}

int main()
{
    Number n1, n2;

    cout << "For first object:\n";
    n1.getData();

    cout << "For second object:\n";
    n2.getData();

    compare(n1, n2);

    return 0;
}
