#include <iostream>
#include <string>
using namespace std;

class Product {
private:
    int id;
    double p;
public:
    void in();
    void out();
};

void Product::in() {
    cin >> id >> p;
}

void Product::out() {
    cout << id << " " << p << endl;
}

int main() {
    Product pr;
    pr.in();
    pr.out();
    return 0;
}

