#include <iostream>
using namespace std;

class Employee
{
    static int count;

public:
    Employee()
    {
        count++;
    }

    static void display()
    {
        cout << "Total Employees = " << count;
    }
};

int Employee::count = 0;

int main()
{
    Employee e1, e2, e3, e4;

    Employee::display();

    return 0;
}
