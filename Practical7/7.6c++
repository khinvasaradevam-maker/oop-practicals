#include <iostream>
using namespace std;

class Book
{
    static int count;

public:
    Book()
    {
        count++;
    }

    static void display()
    {
        cout << "Total Books = " << count;
    }
};

int Book::count = 0;

int main()
{
    Book b1, b2, b3, b4;

    Book::display();

    return 0;
}
