#include <iostream>
using namespace std;

class Student
{
    int rollNo;              // Non-static
    static int count;        // Static

public:
    Student(int r)
    {
        rollNo = r;
        count++;
    }

    void display()
    {
        cout << "Roll No = " << rollNo << endl;
    }

    static void total()
    {
        cout << "Total Students = " << count << endl;
    }
};

int Student::count = 0;

int main()
{
    Student s1(101), s2(102), s3(103);

    s1.display();
    s2.display();
    s3.display();

    Student::total();

    return 0;
}
