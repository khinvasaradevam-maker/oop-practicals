#include <iostream>
using namespace std;

class Staff
{
    string name;
    string post;
    float salary;

public:
    void accept()
    {
        cout << "Enter Name, Post and Salary: ";
        cin >> name >> post >> salary;
    }

    void display()
    {
        if(post == "HOD")
            cout << name << "\t" << post << "\t" << salary << endl;
    }
};

int main()
{
    Staff s[5];

    for(int i = 0; i < 5; i++)
        s[i].accept();

    cout << "\nHOD Staff Details:\n";

    for(int i = 0; i < 5; i++)
        s[i].display();

    return 0;
}
