#include <iostream>
using namespace std;

class Student
{
    int rollNo;
    string name;
    float percentage;

public:
    void accept()
    {
        cout << "Enter Roll No, Name and Percentage: ";
        cin >> rollNo >> name >> percentage;
    }

    void display()
    {
        if(percentage > 75)
            cout << rollNo << "\t" << name << "\t" << percentage << endl;
    }
};

int main()
{
    Student s[10];

    for(int i = 0; i < 10; i++)
        s[i].accept();

    cout << "\nStudents having percentage greater than 75:\n";

    for(int i = 0; i < 10; i++)
        s[i].display();

    return 0;
}
